{
  "manifest_version": 3,
  "name": "Local Mokuro",
  "version": "1.5.1",
  "description": "Scan manga in your current tab using your local Mokuro, with selectable text overlays.",
  "key": "",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "nativeMessaging", "alarms"],
  "host_permissions": ["http://127.0.0.1:8766/*", "http://*/*", "https://*/*"],
  "background": {
    "scripts": ["ocr-result.js", "page-cache.js", "reading-history.js", "background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["ocr-result.js", "content.js"], "run_at": "document_idle"}],
  "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Scan with Local Mokuro", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}},
  "browser_specific_settings": {
    "gecko": {"id": "mokuro-browser@local", "strict_min_version": "121.0"}
  },
  "commands": {
    "scan-largest": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Scan the largest visible manga image"}
  }
}
